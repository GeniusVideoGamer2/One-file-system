# GameXWIN Aether Plymouth boot animation.
# Vector-like logo is rendered with Plymouth's built-in text image.
Window.SetBackgroundTopColor(0.055, 0.035, 0.14);
Window.SetBackgroundBottomColor(0.16, 0.07, 0.29);

width = Window.GetWidth();
height = Window.GetHeight();
center_x = width / 2;
center_y = height / 2;

logo_image = Image.Text("GX", 0.88, 0.73, 1.0);
logo = Sprite(logo_image);
logo.SetZ(100);
logo.SetX(center_x - logo_image.GetWidth() / 2);
logo.SetY(center_y - logo_image.GetHeight() / 2 - 35);

caption_image = Image.Text("GameXWIN  AETHER", 0.77, 0.68, 0.94);
caption = Sprite(caption_image);
caption.SetZ(90);
caption.SetX(center_x - caption_image.GetWidth() / 2);
caption.SetY(center_y + 40);

dot_image = Image.Text("●", 0.74, 0.44, 1.0);
dots = [];
for (i = 0; i < 5; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetZ(95);
}

frame = 0;
fun refresh() {
    frame++;
    phase = frame * 0.075;
    logo.SetOpacity(0.76 + 0.24 * (1 + Math.Sin(phase)) / 2);
    for (i = 0; i < 5; i++) {
        a = phase + i * 6.28318 / 5;
        dots[i].SetX(center_x + Math.Cos(a) * 85 - dot_image.GetWidth() / 2);
        dots[i].SetY(center_y - 18 + Math.Sin(a) * 58 - dot_image.GetHeight() / 2);
        dots[i].SetOpacity(0.35 + 0.65 * (1 + Math.Sin(phase + i)) / 2);
    }
}
Plymouth.SetRefreshFunction(refresh);

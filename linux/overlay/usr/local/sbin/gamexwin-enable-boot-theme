#!/bin/sh
set -eu
# Enable the bundled animated Plymouth theme inside the live filesystem.
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/gamexwin-aether/gamexwin-aether.plymouth 120
update-alternatives --set default.plymouth /usr/share/plymouth/themes/gamexwin-aether/gamexwin-aether.plymouth
update-initramfs -u -k all

#!/usr/bin/env python3
"""GX Installer USB-only preview. READ ONLY; no installation or disk writes."""
import json
import subprocess
import tkinter as tk
from tkinter import ttk, messagebox

root=tk.Tk()
root.title("GX Installer · Portable USB Preview")
root.geometry("880x610")
root.minsize(680,470)
root.configure(bg="#161429")
style=ttk.Style(root)
style.theme_use("clam")
style.configure("TFrame",background="#161429")
style.configure("TLabel",background="#161429",foreground="#f2eaff",font=("Sans",11))
style.configure("TButton",padding=10)
frame=ttk.Frame(root,padding=26)
frame.pack(fill="both",expand=True)
ttk.Label(frame,text="GX  /  Portable USB Installer",font=("Sans",23,"bold")).pack(anchor="w")
ttk.Label(frame,text="USB'ye Taşınabilir Kurulum · Güvenli önizleme").pack(anchor="w",pady=(4,14))
ttk.Label(frame,text="Yalnızca USB bağlantılı fiziksel diskler listelenir. HDD / SSD / NVMe sistem diskleri gizlidir.",wraplength=780).pack(anchor="w",pady=(0,12))
columns=("path","size","model","transport","mounted")
tree=ttk.Treeview(frame,columns=columns,show="headings",height=10,selectmode="browse")
for key,label,width in zip(columns,("USB disk","Boyut","Model","Bağlantı","Bağlı bölümler"),(180,110,200,95,235)):
    tree.heading(key,text=label)
    tree.column(key,width=width)
tree.pack(fill="both",expand=True)
selection=tk.StringVar(value="USB hedefi seçilmedi")
known={}
def scan():
    known.clear()
    tree.delete(*tree.get_children())
    selection.set("USB hedefi seçilmedi")
    try:
        raw=subprocess.check_output(["lsblk","--json","--bytes","-o","PATH,SIZE,MODEL,TYPE,TRAN,MOUNTPOINTS"],text=True,timeout=10)
        disks=json.loads(raw).get("blockdevices",[])
        for item in disks:
            if item.get("type")!="disk" or str(item.get("tran") or "").lower()!="usb":
                continue
            path=item.get("path")
            if not path:continue
            children=item.get("children") or []
            mounts=[]
            for partition in [item]+children:
                mounts.extend(str(m) for m in (partition.get("mountpoints") or []) if m)
            values=(path,f"{int(item.get('size') or 0)/(1024**3):.1f} GiB",item.get("model") or "Unknown","USB",", ".join(mounts) or "—")
            iid=tree.insert("","end",values=values)
            known[iid]=path
    except (OSError,subprocess.SubprocessError,ValueError) as exc:
        messagebox.showerror("GX Installer",f"USB diskleri okunamadı: {exc}")
def choose(_event=None):
    sel=tree.selection()
    selection.set("Seçilen USB (yalnızca önizleme): "+known[sel[0]] if sel and sel[0] in known else "USB hedefi seçilmedi")
tree.bind("<<TreeviewSelect>>",choose)
ttk.Label(frame,textvariable=selection).pack(anchor="w",pady=(12,5))
ttk.Label(frame,text="DİKKAT: Kurulum USB'sinin kendisine yazmak güvenli değildir. Gerçek kurulum için ayrı USB ve bağımsız önyükleyici denetimi gerekir.",wraplength=770).pack(anchor="w",pady=6)
ttk.Label(frame,text="Bu sürüm yalnızca listeler. Bölümleme, biçimlendirme, EFI/önyükleyici yazma ve kurulum DEVRE DIŞIDIR.",wraplength=770).pack(anchor="w",pady=6)
buttons=ttk.Frame(frame)
buttons.pack(fill="x",pady=10)
ttk.Button(buttons,text="USB'leri yenile",command=scan).pack(side="left",padx=(0,12))
ttk.Button(buttons,text="USB'ye yükle (güvenlik için kapalı)",state="disabled").pack(side="left")
scan()
root.mainloop()
